# Shopify Store Configuration
SHOPIFY_SHOP=yezbee-fashion-skmumi5z
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: Direct Admin API Access Token (if using Custom App / OAuth token directly)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify API Version (defaults to 2026-10)
SHOPIFY_API_VERSION=2026-10

# Optional: Preferred Shopify Location ID (if omitted, system will query and prompt/select primary location)
SHOPIFY_LOCATION_ID=

# Firebase Service Account Key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
